root = true

[*.cs]
# Allow .Add() calls instead of collection initializers (Rider CA2000 conflicts with initializer form)
dotnet_style_collection_initializer = false

# Suppress SYSLIB1045: Use GeneratedRegex attribute. A generated regex must live outside the function that uses
# it, and the codebase rule is never to move a Regex out of that function.
dotnet_diagnostic.SYSLIB1045.severity = none

# Remove unnecessary using directives
dotnet_diagnostic.IDE0005.severity = warning
